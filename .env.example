# m7: `docker-compose.yml` previously hardcoded `POSTGRES_PASSWORD:
# validator_dev_pw`, which put a database credential in version control and in
# git history. It now reads these values from the environment and refuses to
# start if they are missing.
#
# Copy this file to `.env` and fill in real values:
#
#     cp .env.example .env
#
# `.env` is gitignored. Never commit it, and never reuse these values anywhere
# that is not a local development machine.

# Required. Compose aborts with an explanatory message if either is unset.
POSTGRES_USER=
POSTGRES_PASSWORD=

# Optional; defaults to module2_validator.
POSTGRES_DB=module2_validator
